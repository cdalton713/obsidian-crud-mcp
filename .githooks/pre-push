#!/bin/sh
# Verify version consistency before pushing a tag

while read local_ref local_sha remote_ref remote_sha; do
    # Only check version tags
    case "$local_ref" in
        refs/tags/v*)
            TAG_VERSION="${local_ref#refs/tags/v}"
            CRATE_VERSION=$(sed -nE 's/^version = "([^"]+)"$/\1/p' Cargo.toml | head -n 1)
            SERVER_VERSION=$(sed -nE 's/^    "version": "([^"]+)",?$/\1/p' server.json | head -n 1)
            CHANGELOG_HAS=$(grep -c "^## ${TAG_VERSION}$" CHANGELOG.md)

            ERRORS=""
            if [ "$CRATE_VERSION" != "$TAG_VERSION" ]; then
                ERRORS="${ERRORS}\n  Cargo.toml: ${CRATE_VERSION} (expected ${TAG_VERSION})"
            fi
            if [ "$SERVER_VERSION" != "$TAG_VERSION" ]; then
                ERRORS="${ERRORS}\n  server.json: ${SERVER_VERSION} (expected ${TAG_VERSION})"
            fi
            if [ "$CHANGELOG_HAS" = "0" ]; then
                ERRORS="${ERRORS}\n  CHANGELOG.md: missing ## ${TAG_VERSION} section"
            fi

            if [ -n "$ERRORS" ]; then
                echo "ERROR: Version mismatch for tag v${TAG_VERSION}:${ERRORS}"
                exit 1
            fi
            ;;
    esac
done

exit 0
