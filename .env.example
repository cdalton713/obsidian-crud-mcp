# Required: the S3 settings from Remotely Save
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=obsidian-vault
S3_ACCESS_KEY_ID=<key-id>
S3_SECRET_ACCESS_KEY=<secret>

# Required
MCP_AUTH_TOKEN=<generate-a-strong-password>
VAULT_NAME=MyVault

# Defaults (usually don't need to change)
# S3_REGION=auto
# S3_PREFIX=
# S3_POLL_SECONDS=30
# Note content kept in memory so search never reads the disk (about this many MB; 0 disables)
# SEARCH_CONTENT_CACHE_MB=32

# Encrypt the persisted search index (paths, tags, links) at rest
# INDEX_PASSPHRASE=your-passphrase

# Optional: semantic search (the semantic_search tool) through a Cloudflare AI Search
# instance that indexes the same bucket. The token needs AI Search Edit and Run.
# CF_ACCOUNT_ID=<account-id>
# CF_AI_SEARCH_TOKEN=<api-token>
# CF_AI_SEARCH_INSTANCE=obsidian-vault
# CF_AI_SEARCH_NAMESPACE=default
